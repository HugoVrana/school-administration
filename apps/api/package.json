{
  "name": "@school/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @school/db build && tsc --noEmit",
    "dev": "tsx watch src/dev-server.ts",
    "doppler:pull": "doppler secrets download --no-file --format env-no-quotes > .env.local",
    "doppler:run": "doppler run -- tsx watch src/dev-server.ts",
    "start": "tsx src/dev-server.ts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.4.3",
    "@hono/node-server": "^2.0.1",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.3.0",
    "@school/db": "workspace:*",
    "hono": "^4.12.16",
    "kysely": "^0.28.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.1.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
