{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "public/**"],
      "passThroughEnv": [
        "CLERK_WEBHOOK_SIGNING_SECRET",
        "PG_CERT",
        "PG_DATABASE",
        "PG_PASSWORD",
        "PG_PORT",
        "PG_URL",
        "PG_USER"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "doppler:run": {
      "cache": false,
      "persistent": true
    }
  }
}
