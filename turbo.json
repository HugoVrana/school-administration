{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", "public/**"],
      "passThroughEnv": [
        "API_CORS_ORIGINS",
        "CLERK_SECRET_KEY",
        "CLERK_WEBHOOK_SIGNING_SECRET",
        "PG_CERT",
        "PG_DATABASE",
        "PG_PASSWORD",
        "PG_PORT",
        "PG_URL",
        "PG_USER",
        "VITE_API_BASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "doppler:run": {
      "cache": false,
      "persistent": true
    },
    "doppler:pull": {
      "cache": false
    }
  }
}
