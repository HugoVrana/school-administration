{
  "name": "@school/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "import": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:pull-secrets": "doppler secrets download --no-file --format env-no-quotes > .env.local",
    "db:migrate": "tsx src/migrate.ts up",
    "db:rollback": "tsx src/migrate.ts down",
    "db:reset": "tsx src/migrate.ts reset",
    "doppler:migrate": "doppler run -- pnpm db:migrate",
    "doppler:rollback": "doppler run -- pnpm db:rollback",
    "doppler:reset": "doppler run -- pnpm db:reset"
  },
  "dependencies": {
    "kysely": "^0.28.16",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/pg": "^8.10.0",
    "eslint": "^9.39.2",
    "globals": "^17.2.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.54.0"
  }
}
